# Copiar a .env y completar. Nunca commitear .env.

# Token que entrega @BotFather
TELEGRAM_BOT_TOKEN=

# IDs de Telegram autorizados, separados por coma (obtener con @userinfobot)
ALLOWED_TELEGRAM_IDS=

# Postgres (Railway: pestaña Variables del servicio Postgres -> DATABASE_PUBLIC_URL para uso local)
DATABASE_URL=

# Se usan en fases posteriores
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude para interpretar mensajes (por defecto claude-opus-5-5)
CLAUDE_MODEL=
DASHBOARD_PASSWORD=
